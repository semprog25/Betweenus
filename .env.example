# Client-safe (used in Vite build — never commit real .env files)
VITE_SUPABASE_PROJECT_ID=qoqbdiixztolvtcjdnle
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
VITE_SITE_URL=https://betweenus.fun

# Server-only — set in Supabase Edge Function secrets, NEVER in frontend
# SUPABASE_SERVICE_ROLE_KEY=
# BETWEENUS_ADMIN_SECRET=
# LANDING_CMS_BOOTSTRAP_ADMIN_IDS=uuid-one,uuid-two
# REVENUECAT_WEBHOOK_SECRET=

# Journal static generator (local/CI) — never commit real service role
# SUPABASE_SERVICE_ROLE_KEY=
# HAS_APP_STORE_LISTING=false

# Optional mobile (Capacitor) — configure in native build env / CI secrets
# REVENUECAT_API_KEY_IOS=
# REVENUECAT_API_KEY_ANDROID=

# Android release signing — NEVER commit keystore or passwords
# BETWEENUS_JAVA_HOME=/opt/homebrew/Cellar/openjdk@21/21.0.11/libexec/openjdk.jdk/Contents/Home
# BETWEENUS_UPLOAD_STORE_FILE=/absolute/path/to/betweenus-upload.jks
# BETWEENUS_UPLOAD_STORE_PASSWORD=
# BETWEENUS_UPLOAD_KEY_ALIAS=
# BETWEENUS_UPLOAD_KEY_PASSWORD=

# AdMob — keep TEST IDs in development. For store/release builds only:
# VITE_ADMOB_USE_PRODUCTION=true
# VITE_ADMOB_ANDROID_APP_ID=ca-app-pub-3084834499411817~3076706540
# VITE_ADMOB_ANDROID_NATIVE_UNIT_ID=ca-app-pub-3084834499411817/4501468858
# VITE_ADMOB_NATIVE_UNIT_ID=ca-app-pub-3084834499411817/4501468858
# VITE_ADMOB_IOS_APP_ID=
# VITE_ADMOB_IOS_NATIVE_UNIT_ID=

# Website AdSense (public client/slot IDs are not secrets — still do not invent values)
# Publisher confirmed in AdSense UI. Slots remain empty until site approval allows ad units.
# BETWEENUS_ADSENSE_CLIENT_ID=ca-pub-3084834499411817
# BETWEENUS_ADSENSE_SLOT_ARTICLE_MID1=
# BETWEENUS_ADSENSE_SLOT_ARTICLE_MID2=
# BETWEENUS_ADSENSE_SLOT_ARTICLE_AFTER=
# BETWEENUS_ADSENSE_CONSENT_READY=false
# BETWEENUS_ADSENSE_FORCE_DISABLED=false
# Also keep src/web/adsenseConfig.ts in sync (client id set; slots empty; consent false).
# Live ads.txt (site root) — Google-provided:
#   google.com, pub-3084834499411817, DIRECT, f08c47fec0942fa0
# Do NOT use AdMob ca-app-pub-… IDs for website Journal ads.