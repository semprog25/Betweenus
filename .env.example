# Client-safe (used in Vite build — never commit real .env files)
VITE_SUPABASE_PROJECT_ID=qoqbdiixztolvtcjdnle
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
VITE_SITE_URL=https://betweenus.fun

# Server-only — set in Supabase Edge Function secrets, NEVER in frontend
# SUPABASE_SERVICE_ROLE_KEY=
# BETWEENUS_ADMIN_SECRET=
# REVENUECAT_WEBHOOK_SECRET=

# Optional mobile (Capacitor) — configure in native build env / CI secrets
# REVENUECAT_API_KEY_IOS=
# REVENUECAT_API_KEY_ANDROID=

# AdMob — keep TEST IDs in development. For store/release builds only:
# VITE_ADMOB_USE_PRODUCTION=true
# VITE_ADMOB_ANDROID_APP_ID=ca-app-pub-3084834499411817~3076706540
# VITE_ADMOB_ANDROID_NATIVE_UNIT_ID=ca-app-pub-3084834499411817/4501468858
# VITE_ADMOB_NATIVE_UNIT_ID=ca-app-pub-3084834499411817/4501468858
# VITE_ADMOB_IOS_APP_ID=
